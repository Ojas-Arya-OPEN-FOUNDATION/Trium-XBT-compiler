# =============================================================================
# File: hw/synth_xbt_yosys.ys
# Description: Real Yosys synthesis script for the Trium-XBT RISC-V Custom-0
#              hardware extension (hw/riscv_xbt_extension.sv).
#
# Usage:
#   yosys -s hw/synth_xbt_yosys.ys
#
# Synthesizes each core module to CMOS2 standard gates and reports exact
# gate counts and cell statistics (replacing analytical Python estimates).
# =============================================================================

# Read SystemVerilog RTL once and snapshot clean AST/RTLIL
read_verilog -sv hw/riscv_xbt_extension.sv
design -save xbt_rtl

# 1. xbt_btha64 (64-Trit Balanced Ternary Half-Adder)
log "=== Synthesizing xbt_btha64 ==="
design -load xbt_rtl
synth -top xbt_btha64 -noabc
techmap -map hw/cmos2_map.v
opt_clean -purge
stat

# 2. xbt_kogge_stone_adder64 (v1 6-Stage Kogge-Stone Adder)
log "=== Synthesizing xbt_kogge_stone_adder64 ==="
design -load xbt_rtl
synth -top xbt_kogge_stone_adder64 -noabc
techmap -map hw/cmos2_map.v
opt_clean -purge
stat

# 3. xbt_kogge_stone_adder64_v2 (v2 Monotone Lattice Kogge-Stone Adder)
log "=== Synthesizing xbt_kogge_stone_adder64_v2 ==="
design -load xbt_rtl
synth -top xbt_kogge_stone_adder64_v2 -noabc
techmap -map hw/cmos2_map.v
opt_clean -purge
stat


# 3b. xbt_brent_kung_adder64 (Area-Optimized Brent-Kung Prefix Adder)
log "=== Synthesizing xbt_brent_kung_adder64 ==="
design -load xbt_rtl
synth -top xbt_brent_kung_adder64 -noabc
techmap -map hw/cmos2_map.v
opt_clean -purge
stat

# 4. xbt_planar_dot64 (64-Trit Planar Dot Product Unit)
log "=== Synthesizing xbt_planar_dot64 ==="
design -load xbt_rtl
synth -top xbt_planar_dot64 -noabc
techmap -map hw/cmos2_map.v
opt_clean -purge
stat

# 5. xbt_base243_decoder (Division-Free Base-243 Unpacker)
log "=== Synthesizing xbt_base243_decoder ==="
design -load xbt_rtl
synth -top xbt_base243_decoder -noabc
techmap -map hw/cmos2_map.v
opt_clean -purge
stat

# 6. riscv_xbt_alu (Top-Level v1 + v2 Custom-0 Execution Unit)
log "=== Synthesizing riscv_xbt_alu ==="
design -load xbt_rtl
synth -top riscv_xbt_alu -noabc
techmap -map hw/cmos2_map.v
opt_clean -purge
stat
